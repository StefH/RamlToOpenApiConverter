<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Description>Source Code only project to convert RAML file to Open API Specification. Note that thisversion is compatible with Microsoft.OpenApi:3.10.2 and SharpYaml:2.1.5</Description>
        <AssemblyOriginatorKeyFile>../RamlToOpenApiConverter/RamlToOpenApiConverter.snk</AssemblyOriginatorKeyFile>
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\RamlToOpenApiConverter\**\*.cs" Exclude="bin\**\*.cs">
            <Pack>true</Pack>
            <PackagePath>contentFiles\cs\any\RamlToOpenApiConverter</PackagePath>
            <BuildAction>Compile</BuildAction>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="obj\**" />
        <Content Remove="..\RamlToOpenApiConverter\obj\**" />
        <EmbeddedResource Remove="obj\**" />
        <None Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.10.2" PrivateAssets="All" />
    </ItemGroup>

</Project>