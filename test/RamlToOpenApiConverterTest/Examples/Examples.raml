#%RAML 1.0
title: include example files
description: this is a description of include example using include
protocols:
  - HTTP
version: 1.0
mediaType:
  - application/json

types:
  Email:
    type: object
    properties:
      subject:
        type: string
      body:
        type: string
  Emails:
    type: array
    items: Email

/testemails5:
  get:
    description: examples with inline single as object
    responses:
      200:
        body:
          application/json:
            type: Email
            examples:
              example1:
                - subject: "Email subject1"
                  body: "Email body1"

              example2:
                - subject: "A"
                  body: "B"

/testemails6:
  get:
    description: examples with inline list as object
    responses:
      200:
        body:
          application/json:
            type: Emails
            examples:
              example1:
                - subject: "Email subject1"
                  body: "Email body1"
                - subject: "Email subject2"
                  body: "Email body2"

              example2:
                - subject: "A"
                  body: "B"
                - subject: "X"
                  body: "Y"

/testemails0:
  get:
    description: example with include single
    responses:
      200:
        body:
          application/json:
            type: Email
            example: !include examples/email.json

/testemails1:
  get:
    description: example with include list
    responses:
      200:
        body:
          application/json:
            type: Emails
            example: !include examples/emails.json

/testemails2:
  get:
    description: example with inline single
    responses:
      200:
        body:
          application/json:
            type: Email
            example: |
              {
                "subject": "Email subject1",
                "body": "Email body1"
              }

/testemails3:
  get:
    description: example with inline list as string
    responses:
      200:
        body:
          application/json:
            type: Emails
            example: |
              [{
                "subject": "Email subject1",
                "body": "Email body1"
              },
              {
                "subject": "Email subject2",
                "body": "Email body2"
              }]

/testemails4:
  get:
    description: examples with inline single as string
    responses:
      200:
        body:
          application/json:
            type: Email
            examples:
              example1: |
                {
                  "subject": "Email subject1",
                  "body": "Email body1"
                }
              example2: |
                {
                  "subject": "Email subject2",
                  "body": "Email body2"
                }